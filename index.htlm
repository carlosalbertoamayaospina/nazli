<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Cosméticos Multimarca | Nasly Gutiérrez Terán</title>
<style>
:root{
 --vino:#64243f;--ciruela:#8a3d68;--fucsia:#d12670;--rosa:#f29ab8;
 --rosa-claro:#ffe7ef;--oro:#c99b43;--oro-claro:#f7df9a;
 --crema:#fff8ef;--verde:#607b35;--whatsapp:#1b9b6c;--texto:#392a31;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:Arial,Helvetica,sans-serif;color:var(--texto);background:linear-gradient(180deg,#fffaf7,#fff0f5)}
a{text-decoration:none;color:inherit}
.wrap{max-width:1140px;margin:auto;padding:0 18px}
header{height:68px;background:rgba(255,255,255,.94);backdrop-filter:blur(14px);position:sticky;top:0;z-index:30;border-bottom:1px solid #efd5df}
.nav{height:100%;display:flex;align-items:center;justify-content:space-between}
.navbrand{font-family:Georgia,serif;font-weight:bold;font-size:18px;color:var(--vino)}
.navbrand small{display:block;font-family:Arial,sans-serif;font-size:9px;letter-spacing:2px;color:var(--oro)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:14px 20px;border:0;border-radius:16px;font-weight:800;cursor:pointer}
.pink{color:white;background:linear-gradient(135deg,var(--fucsia),var(--vino));box-shadow:0 9px 20px rgba(150,30,82,.22)}
.wa{color:white;background:linear-gradient(135deg,#28ad7d,#13865f);box-shadow:0 9px 20px rgba(23,133,94,.2)}
@media(max-width:760px){.hero::after{width:180px;height:180px;right:-70px;top:-30px;opacity:.55}}
.hero{
 padding:46px 0 42px;position:relative;overflow:hidden;
 background:
 linear-gradient(90deg,rgba(31,15,25,.56) 0%,rgba(78,32,54,.36) 43%,rgba(255,186,105,.12) 100%),
 url('https://images.unsplash.com/photo-1518509562904-e7ef99cdcc86?auto=format&fit=crop&w=1800&q=92') center/cover;
}

.hero-grid{display:grid;grid-template-columns:1fr .92fr;gap:32px;align-items:center;position:relative}
.kicker{font-size:11px;font-weight:900;letter-spacing:2.4px;color:#ffe5a0;text-transform:uppercase;text-shadow:0 2px 8px rgba(0,0,0,.45)}
h1{font-family:Georgia,serif;font-size:clamp(48px,7vw,82px);line-height:.9;margin:12px 0 10px;letter-spacing:-2px}
.metal{
 background:linear-gradient(105deg,#70451b 0%,#f8e6a6 20%,#b88227 42%,#fff3c9 58%,#8c5e1f 78%,#d9b66a 100%);
 -webkit-background-clip:text;background-clip:text;color:transparent;
 filter:drop-shadow(0 1px 0 white)
}
.tagline{font-family:Georgia,serif;font-style:italic;font-size:clamp(22px,3vw,31px);font-weight:bold;color:#ffd4e2;text-shadow:0 2px 8px rgba(0,0,0,.55);margin-bottom:15px}
.owner-name{font-size:27px;font-weight:900;color:#fff7ef;text-shadow:0 2px 8px rgba(0,0,0,.55);margin-bottom:12px}
.lead{font-size:18px;line-height:1.6;color:#fff8f2;text-shadow:0 2px 8px rgba(0,0,0,.55);max-width:590px}
.collage-box{height:405px;border-radius:30px;overflow:hidden;position:relative;box-shadow:0 24px 55px rgba(75,34,44,.25);border:4px solid rgba(255,255,255,.62)}
.collage{height:100%;display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:1fr 1fr;gap:4px;background:#fff}
.tile{background-size:cover;background-position:center}
.t1{background-image:url('https://images.unsplash.com/photo-1596462502278-27bfdc403348?auto=format&fit=crop&w=900&q=80')}
.t2,.t3,.t4,.t5,.t6{background-size:50% 50%,50% 50%,50% 50%,50% 50%;background-position:left top,right top,left bottom,right bottom;background-repeat:no-repeat}
.t2{background-image:url('https://images.unsplash.com/photo-1592945403244-b3fbafd7f539?auto=format&fit=crop&w=900&q=85'),url('https://images.unsplash.com/photo-1617897903246-719242758050?auto=format&fit=crop&w=900&q=85'),url('https://images.unsplash.com/photo-1608248597279-f99d160bfcbc?auto=format&fit=crop&w=900&q=85'),url('data:image/jpeg;base64,')}
.t3{background-image:url('https://images.unsplash.com/photo-1599733594230-6b823276abcc?auto=format&fit=crop&w=900&q=85'),url('https://images.unsplash.com/photo-1512496015851-a90fb38ba796?auto=format&fit=crop&w=900&q=85'),url('https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?auto=format&fit=crop&w=900&q=85'),url('data:image/jpeg;base64,')}
.t4{background-image:url('https://images.unsplash.com/photo-1588405748880-12d1d2a59f75?auto=format&fit=crop&w=900&q=85'),url('https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=900&q=85'),url('https://images.unsplash.com/photo-1556229010-6c3f2c9ca5f8?auto=format&fit=crop&w=900&q=85'),url('https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=900&q=85')}
.t5{background-image:url('https://images.unsplash.com/photo-1485230895905-ec40ba36b9bc?auto=format&fit=crop&w=900&q=85'),url('https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=900&q=85'),url('https://images.unsplash.com/photo-1485968579580-b6d095142e6e?auto=format&fit=crop&w=900&q=85'),url('https://images.unsplash.com/photo-1515372039744-b8f02a3ae446?auto=format&fit=crop&w=900&q=85')}
.t6{background-image:url('https://images.unsplash.com/photo-1596755389378-c31d21fd1273?auto=format&fit=crop&w=900&q=85'),url('https://images.unsplash.com/photo-1629198688000-71f23e745b6e?auto=format&fit=crop&w=900&q=85'),url('https://images.unsplash.com/photo-1596462502278-27bfdc403348?auto=format&fit=crop&w=900&q=85'),url('https://images.unsplash.com/photo-1571781926291-c477ebfd024b?auto=format&fit=crop&w=900&q=85')}
section{padding:52px 0}
.title{font-family:Georgia,serif;font-size:35px;text-align:center;margin:0 0 9px;color:var(--vino)}
.title:after{content:" ✦ ";color:var(--oro)}
.sub{text-align:center;color:#806b73;font-size:17px;line-height:1.5;margin:0 auto 28px;max-width:720px}
.catalogs{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.card{border-radius:24px;overflow:hidden;background:white;border:1px solid #efd3dd;box-shadow:0 10px 28px rgba(93,37,62,.08)}
.card-img{height:220px;background-size:50% 50%,50% 50%,50% 50%,50% 50%;background-position:left top,right top,left bottom,right bottom;background-repeat:no-repeat;position:relative}

.card-img:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(65,20,42,.22),transparent 60%)}
.avon{background-image:url('https://images.unsplash.com/photo-1596462502278-27bfdc403348?auto=format&fit=crop&w=700&q=90'),url('https://images.unsplash.com/photo-1512496015851-a90fb38ba796?auto=format&fit=crop&w=700&q=90'),url('https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&w=700&q=90'),url('https://images.unsplash.com/photo-1631214524020-7e18db9a8f92?auto=format&fit=crop&w=700&q=90')}
.natura{background-image:url('data:image/jpeg;base64,')!important;background-size:cover!important;background-position:center!important;background-repeat:no-repeat!important}
.boticario{background-image:url('https://images.unsplash.com/photo-1541643600914-78b084683601?auto=format&fit=crop&w=700&q=90'),url('https://images.unsplash.com/photo-1585386959984-a4155224a1ad?auto=format&fit=crop&w=700&q=90'),url('https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=700&q=90'),url('https://images.unsplash.com/photo-1591375275693-9b29d0b15f55?auto=format&fit=crop&w=700&q=90')}
.boticario.boticario-collage{background:none!important;display:grid;grid-template-columns:1fr 1fr;gap:3px;padding:3px;background:#e7e1dc;overflow:hidden}
.boticario-collage .boti-tile{background-size:cover;background-position:center;min-height:100%}
.boticario-collage .boti-a{background-image:url('https://checkout.oboticario.com.co/cdn/shop/files/DesktopMeca-Perfume_0cf8c844-e4d3-4dfa-9dd5-2cf2e089baa6.jpg');background-position:center}
.boticario-collage .boti-b{background-image:url('https://www.blog-perfumes.pt/wp-content/uploads/2025/06/melhores-perfumes-boticario-aromas-que-marcam-diferenca-850.jpg');background-position:center}

/* Carmel Pacífica: collage de 4 cuadros optimizado para verse bien en el frontend. */
.moda{background:none!important;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:6px;padding:6px;background:#f2ede8;overflow:hidden}
.moda .moda-tile{background-size:cover;background-repeat:no-repeat;background-color:#fff;min-width:0;min-height:0;background-position:center center}
.moda .moda-a{background-image:url('https://nuevasrevistas.com/revistas/co/pacifika/2026_catalogo_05/40.webp')}
.moda .moda-b{background-image:url('https://nuevasrevistas.com/revistas/co/pacifika/2026_catalogo_05/13.webp')}
.moda .moda-c{background-image:url('https://nuevasrevistas.com/revistas/co/carmel/2026_catalogo_04/69.webp')}
.moda .moda-d{background-image:url('https://nuevasrevistas.com/revistas/co/pacifika/2026_catalogo_05/31.webp')}
.gosen{background-color:#f7f2f4;background-image:url('https://images.unsplash.com/photo-1523293182086-7651a899d37f?auto=format&fit=crop&w=700&q=90'),url('https://images.unsplash.com/photo-1556228578-8c89e6adf883?auto=format&fit=crop&w=700&q=90'),url('https://images.unsplash.com/photo-1594035910387-fea47794261f?auto=format&fit=crop&w=700&q=90'),url('https://images.unsplash.com/photo-1611930022073-b7a4ba5fcccd?auto=format&fit=crop&w=700&q=90');background-size:48% 48%,48% 48%,48% 48%,48% 48%;background-position:left top,right top,left bottom,right bottom;background-repeat:no-repeat,no-repeat,no-repeat,no-repeat}
.news{background:linear-gradient(135deg,#ffd5e5,#f7a9c7 45%,#f4d18d);position:relative;overflow:hidden}.news.has-promo{background-size:cover;background-position:center;background-repeat:no-repeat}.news-upload{position:absolute;inset:0;display:grid;place-items:center;background:rgba(255,255,255,.10)}.news-upload label{background:rgba(255,255,255,.94);color:#8d214b;padding:12px 16px;border-radius:14px;font-weight:900;cursor:pointer;box-shadow:0 8px 18px rgba(80,20,50,.12);text-align:center}.news-upload input{display:none}.news.has-promo .news-upload label{opacity:0}.news.has-promo:hover .news-upload label{opacity:1}
.card-body{padding:18px}
.card h3{margin:0 0 7px;font-size:24px;font-family:Georgia,serif;color:var(--vino)}
.card p{margin:0;color:#735e66;line-height:1.45;min-height:44px}
.actions{display:grid;gap:9px;margin-top:16px}
.catalog-btn{display:block;text-align:center;padding:13px;border-radius:14px;font-weight:900;color:white;background:linear-gradient(135deg,#bf7d20,#e2b952,#9b6421);box-shadow:0 7px 16px rgba(172,112,29,.18)}
.catalog-btn.pending{background:linear-gradient(135deg,#9b5175,#d686a3)}
.how{background:linear-gradient(120deg,var(--vino),#9a416e 60%,#e2739a);color:white;border-radius:30px;padding:31px;box-shadow:0 16px 35px rgba(94,35,62,.17)}
.how h2{text-align:center;font-family:Georgia,serif;font-size:32px;margin:0 0 22px}.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.step{padding:9px;text-align:center}.num{font-size:33px;color:var(--oro-claro);font-weight:900}
.info{display:grid;grid-template-columns:1.15fr 1fr;gap:20px}
.contact-panel{padding:25px;border-radius:26px;background:linear-gradient(135deg,#ffe2eb,#f38caf 55%,#a53e6c);color:#54213a;box-shadow:0 16px 32px rgba(176,53,102,.16)}
.pay-panel{padding:25px;border-radius:26px;background:linear-gradient(135deg,#fff1d2,#f6c66b 45%,#df8c54);box-shadow:0 16px 32px rgba(207,134,55,.16)}
.panel-title{font-family:Georgia,serif;font-size:30px;margin:0 0 18px}
.contact-flex{display:flex;gap:20px;align-items:center}
.photo-wrap{width:135px;min-width:135px;height:135px;border-radius:50%;padding:5px;background:linear-gradient(135deg,#fff,#d9a2b5,#fff);box-shadow:0 10px 24px rgba(92,27,58,.25)}
#naslyPhoto{width:100%;height:100%;border-radius:50%;object-fit:cover;display:none}
.photo-placeholder{width:100%;height:100%;border-radius:50%;display:flex;align-items:center;justify-content:center;text-align:center;background:#fff4f7;color:#9d5571;font-size:12px;font-weight:800;padding:12px}
.upload-photo{margin-top:12px;padding:10px 14px;border-radius:14px;border:0;background:linear-gradient(135deg,var(--fucsia),var(--vino));color:#fff;font-weight:900;cursor:pointer}
#photoInput{display:none}
.news .photo-wrap{width:100%;min-width:0;height:100%;padding:0;border-radius:0;background:none;box-shadow:none}
.contact-data p{margin:7px 0;font-weight:600}
.pay-items{display:grid;grid-template-columns:1fr 1fr;gap:12px}.pay-item{background:rgba(255,255,255,.52);padding:15px;border-radius:17px;font-weight:800;font-size:17px}
.nequi-box{margin-top:15px;background:rgba(255,255,255,.66);padding:16px;border-radius:18px}.nequi-number{font-size:25px;font-weight:900;color:var(--vino)}.nequi-toggle{border:0;width:100%;text-align:left;cursor:pointer;font-family:inherit;color:inherit}.nequi-number{grid-column:1/-1;text-align:center}
.admin{border-radius:24px;padding:24px;background:linear-gradient(135deg,#fff0f5,#ffd4e4 52%,#f8d59a);border:2px dashed #b65c82;box-shadow:0 14px 30px rgba(154,65,110,.12)}.admin summary{cursor:pointer;font-weight:900;color:var(--vino)}.admin-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:15px}.admin label{font-size:12px;font-weight:900}.admin input{width:100%;padding:11px;border:1px solid #e6c8d3;border-radius:12px;margin-top:4px}
footer{margin-top:25px;padding:40px 0 85px;position:relative;overflow:hidden;color:#fff;background:linear-gradient(120deg,#531a38,#8a2e5a,#c14779)}
footer:before,footer:after{position:absolute;font-size:70px;color:#f5a4bc;opacity:.7}footer:before{content:"✿ ✿";left:15px;bottom:0}footer:after{content:"✿ ✿";right:15px;bottom:0}
.footer-content{position:relative;text-align:center}.footer-brand{font-family:Georgia,serif;font-size:38px;background:linear-gradient(110deg,#f6d58b,#fff0b6,#c7953c);-webkit-background-clip:text;background-clip:text;color:transparent}
.footer-tag{font-family:Georgia,serif;font-style:italic;font-size:20px;color:#ffe5ef;margin-top:4px}
.footer-text{max-width:580px;margin:18px auto 0;line-height:1.6;color:#ffe8ef}

@media(max-width:800px){.hero-grid,.info{grid-template-columns:1fr}.catalogs{grid-template-columns:1fr 1fr}.collage-box{height:330px}.steps{grid-template-columns:1fr 1fr}}
@media(max-width:520px){.catalogs{grid-template-columns:1fr}.steps,.admin-grid{grid-template-columns:1fr}.contact-flex{align-items:flex-start}.hero{padding-top:30px}.navbrand{font-size:14px}.btn{padding:11px 14px}.pay-items{grid-template-columns:1fr}}

.social-row{display:flex;gap:14px;justify-content:center;margin-top:18px}
.social-btn{width:52px;height:52px;border-radius:50%;display:grid;place-items:center;color:#fff;font-size:28px;font-weight:900;text-decoration:none;box-shadow:0 8px 18px rgba(80,20,50,.18)}
.facebook{background:#1877f2}.threads{background:#000;color:#fff;font-weight:700;font-size:24px}
.closing-blessing{margin-top:30px;padding:36px 24px;border-radius:30px;background:linear-gradient(135deg,#4b1028,#8d214b 50%,#c1794f);color:#fff;text-align:center;position:relative;overflow:hidden}
.closing-blessing:before,.closing-blessing:after{content:"🌹";font-size:72px;position:absolute;top:18px;filter:drop-shadow(0 6px 8px rgba(0,0,0,.22))}
.closing-blessing:before{left:18px}.closing-blessing:after{right:18px;transform:scaleX(-1)}
.closing-title{font-size:clamp(24px,4vw,38px);font-weight:900;letter-spacing:.5px;position:relative}
.closing-sub{font-family:Georgia,serif;font-style:italic;font-size:20px;color:#ffdca0;margin:7px 0 24px;position:relative}
.verse{max-width:650px;margin:auto;font-family:Georgia,serif;font-size:clamp(19px,3vw,25px);line-height:1.55;position:relative}
.verse-ref{margin-top:10px;color:#ffdca0;font-weight:900;position:relative}
.news-upload{display:block;margin:14px auto 0;width:max-content;padding:12px 18px;border-radius:14px;background:#fff;color:#8d214b;font-weight:900;cursor:pointer}
.news-upload input{display:none}
.nequi-number{margin:12px auto 0;padding:11px 18px;width:max-content;border-radius:14px;background:#fff7fb;color:#8d214b;font-weight:900;font-size:21px}
.thanks-box{margin-top:18px;min-height:180px;padding:34px 42px;border-radius:22px;background:linear-gradient(135deg,#4a174d 0%,#6f2b67 48%,#9a587a 100%);text-align:center;font-family:Georgia,serif;font-style:italic;font-size:clamp(22px,3vw,30px);font-weight:700;line-height:1.18;color:#fff6fb;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;box-shadow:inset 0 0 0 1px rgba(255,255,255,.13),0 12px 30px rgba(65,17,64,.22)}
.thanks-box::before,.thanks-box::after{content:"";position:absolute;pointer-events:none;opacity:.22;background:radial-gradient(ellipse at center,rgba(255,213,233,.75) 0 32%,transparent 34%),radial-gradient(ellipse at center,rgba(255,213,233,.5) 0 30%,transparent 32%),radial-gradient(ellipse at center,rgba(255,213,233,.38) 0 28%,transparent 30%);background-size:74px 40px,58px 34px,46px 28px;background-repeat:no-repeat}
.thanks-box::before{width:220px;height:170px;left:-48px;bottom:-70px;transform:rotate(-22deg);background-position:20px 40px,96px 14px,150px 76px}
.thanks-box::after{width:220px;height:170px;right:-48px;top:-70px;transform:rotate(18deg);background-position:28px 68px,104px 20px,154px 86px}
.thanks-message{position:relative;z-index:2;max-width:560px;text-shadow:0 2px 10px rgba(35,5,35,.35)}
.thanks-box .heart{display:block;font-size:36px;line-height:1;color:#f6a8c8;margin-top:10px;text-shadow:none}
@media(max-width:620px){.thanks-box{min-height:150px;padding:30px 34px;font-size:22px}.thanks-box::before{left:-95px;bottom:-88px}.thanks-box::after{right:-95px;top:-88px}}

/* Decoración exclusiva del recuadro final Cosméticos Multimarca */
footer .footer-content{position:relative;overflow:hidden;border-radius:24px;padding:34px 44px;background:linear-gradient(135deg,rgba(92,28,86,.98),rgba(160,45,91,.96),rgba(103,25,70,.98));isolation:isolate}
footer .footer-content::before,footer .footer-content::after{content:"";position:absolute;z-index:-1;width:190px;height:190px;opacity:.28;filter:blur(.2px);background:radial-gradient(circle at 50% 30%,#ffd6e6 0 9%,transparent 10%),radial-gradient(ellipse at 30% 52%,#ff7aa8 0 20%,transparent 21%),radial-gradient(ellipse at 70% 52%,#ff4f88 0 20%,transparent 21%),radial-gradient(ellipse at 50% 75%,#d91d58 0 22%,transparent 23%),radial-gradient(circle at 50% 52%,#ffe8ef 0 12%,#d91d58 13% 18%,transparent 19%)}
footer .footer-content::before{left:-58px;bottom:-70px;transform:rotate(-22deg)}
footer .footer-content::after{right:-58px;top:-70px;transform:rotate(28deg)}
footer .footer-brand,footer .footer-tag,footer .footer-text{position:relative;z-index:1}
.footer-verse{position:relative;z-index:1;max-width:760px;margin:18px auto 0;text-align:center;font-style:italic;line-height:1.5;color:rgba(255,245,249,.96);text-shadow:0 1px 8px rgba(40,0,25,.35)}
.footer-verse strong{display:block;margin-top:6px;font-size:.88em;letter-spacing:.08em;font-style:normal;color:#ffd1df}



/* Bloque de Novedades */
.novedades-panel{max-width:820px;margin:0 auto;padding:26px;border-radius:28px;background:linear-gradient(135deg,#fff0f5,#ffd7e6 52%,#f7d59a);border:1px solid #edc1d2;box-shadow:0 14px 30px rgba(154,65,110,.12);text-align:center}
.novedades-panel .panel-title{color:var(--vino);margin-bottom:16px}
.news-preview{position:relative;min-height:280px;border-radius:20px;overflow:hidden;background:rgba(255,255,255,.72);border:2px dashed #c77b9a;display:grid;place-items:center}
.news-preview label{width:100%;min-height:280px;display:grid;place-items:center;padding:24px;cursor:pointer;color:#8d214b;font-weight:900;font-size:17px;line-height:1.5}
#newsPhoto{width:100%;height:100%;min-height:280px;max-height:560px;object-fit:contain;display:none;background:#fff}
#newsInput{position:absolute;width:1px;height:1px;opacity:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.news-actions{margin-top:16px}

</style>


<style id="novedades-grid-placement">
.card.novedades-card{display:flex;min-width:0}
.card.novedades-card .card-body{width:100%;display:flex;flex-direction:column}
.card.novedades-card .novedades-panel{width:100%;height:100%;display:flex;flex-direction:column}
.card.novedades-card .news-preview{flex:1;min-height:220px}
.card.novedades-card #newsInput{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}
.card.novedades-card .news-actions{margin-top:auto}
</style>

