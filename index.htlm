<footer><div class="wrap footer-content"><div class="footer-brand">COSMÉTICOS MULTIMARCA</div><div class="footer-tag">Belleza, aromas y estilo</div><div class="footer-text">Belleza que inspira, estilo que expresa y abundancia que transforma.</div><div class="footer-verse">“Encomienda al Señor tus obras, y tus pensamientos serán afirmados.”<strong>PROVERBIOS 16:3</strong></div></div></footer>


<script>
const phone='573017481422';
const makeWa=t=>'javascript:openWhatsApp('+JSON.stringify(t)+')';
function openWhatsApp(t){
 const msg='Hola Nasly 😊 Vi tu página y quiero consultar sobre '+t+'.';
 const app='whatsapp://send?phone='+phone+'&text='+encodeURIComponent(msg);
 window.location.href=app;
 setTimeout(()=>{ if(document.visibilityState==='visible'){ window.open('https://api.whatsapp.com/send?phone='+phone+'&text='+encodeURIComponent(msg),'_blank'); }},900);
}
document.querySelectorAll('.wbtn').forEach(a=>a.href=makeWa(a.dataset.text));
document.getElementById('heroWa').href=makeWa('tus productos');
const newsWa=document.getElementById('newsWa'); if(newsWa) newsWa.href='javascript:openWhatsApp('+JSON.stringify(msg)+')';
document.getElementById('contactWa').href=makeWa('un pedido');
document.getElementById('navWa').href=makeWa('tus productos');
const keys=['natura','avon','boticario','moda','gosen'];
function applyCatalogLink(k,v){
 const a=document.querySelector('[data-cat="'+k+'"]');
 if(!a)return;
 if(v){a.href=v;a.target='_blank';a.classList.remove('pending');}
 else{a.href='#';a.classList.add('pending');}
}
keys.forEach(k=>{
 const a=document.querySelector('[data-cat="'+k+'"]');
 const input=document.getElementById('in-'+k);
 if(!a||!input)return;
 let saved='';
 try{saved=localStorage.getItem('nasly_'+k)||'';}catch(e){}
 const current=a.getAttribute('href');
 const v=saved||(current&&current!=='#'?current:'');
 input.value=v;
 applyCatalogLink(k,v);
});
function saveLinks(){
 keys.forEach(k=>{
  const input=document.getElementById('in-'+k);
  const v=input?input.value.trim():'';
  applyCatalogLink(k,v);
  try{localStorage.setItem('nasly_'+k,v);}catch(e){}
 });
 alert('Enlaces actualizados correctamente.');
}
const saveLinksButton=document.getElementById('saveLinksButton');
if(saveLinksButton){
 saveLinksButton.addEventListener('click',function(e){e.preventDefault();saveLinks();});
}
document.getElementById('photoInput').addEventListener('change',e=>{const f=e.target.files[0];if(!f)return;const img=document.getElementById('naslyPhoto');img.src=URL.createObjectURL(f);img.style.display='block';document.getElementById('photoPlaceholder').style.display='none';});
const newsInput=document.getElementById('newsInput');
const newsPlaceholder=document.getElementById('newsPlaceholder');
const newsPhoto=document.getElementById('newsPhoto');
if(newsInput&&newsPlaceholder&&newsPhoto){newsInput.addEventListener('change',e=>{const f=e.target.files&&e.target.files[0];if(!f)return;newsPhoto.src=URL.createObjectURL(f);newsPhoto.style.display='block';newsPlaceholder.style.display='none';});}
const newsWa=document.getElementById('newsWa');
if(newsWa){newsWa.addEventListener('click',e=>{e.preventDefault();const msg='Hola, me interesa este producto. Quisiera recibir más información.';const url='https://api.whatsapp.com/send?phone='+phone+'&text='+encodeURIComponent(msg);window.open(url,'_blank');});}




</script>



<script>
document.addEventListener("DOMContentLoaded",function(){const b=document.getElementById("nequiToggle"),n=document.getElementById("nequiNumber");if(b&&n)b.addEventListener("click",function(){const open=n.hasAttribute("hidden");if(open){n.removeAttribute("hidden");b.setAttribute("aria-expanded","true");}else{n.setAttribute("hidden","");b.setAttribute("aria-expanded","false");}});});
</script>
</body></html>
